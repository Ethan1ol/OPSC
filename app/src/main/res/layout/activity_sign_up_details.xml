<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".signUpDetailsActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <!-- Header: logo and app name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@null"
                    android:src="@drawable/logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/app_name"
                    android:textColor="@color/black"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- White card holding the form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/signUp_link"
                    android:textColor="@color/black"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/BattleLabel"
                    android:id="@+id/textEmail"
                    android:text="@string/email_sisplay" />

                <EditText
                    android:id="@+id/textEmailDetail"
                    style="@style/BattleInput"
                    android:autofillHints="emailAddress"
                    android:hint="@string/email_hint"
                    android:inputType="textEmailAddress" />

                <TextView
                    style="@style/BattleLabel"
                    android:id="@+id/textName"
                    android:text="@string/name" />

                <EditText
                    android:id="@+id/textNameDetail"
                    style="@style/BattleInput"
                    android:autofillHints="givenName"
                    android:hint="@string/enter_name"
                    android:inputType="textPersonName|textCapWords" />

                <TextView
                    style="@style/BattleLabel"
                    android:id="@+id/textSurname"
                    android:text="@string/surname" />

                <EditText
                    android:id="@+id/textSurnameDetail"
                    style="@style/BattleInput"
                    android:autofillHints="familyName"
                    android:hint="@string/enter_surname"
                    android:inputType="textPersonName|textCapWords" />

                <TextView
                    style="@style/BattleLabel"
                    android:id="@+id/textDate"
                    android:text="@string/birth_date" />

                <EditText
                    android:id="@+id/textBirthDate"
                    style="@style/BattleInput"
                    android:autofillHints="@null"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/pick_birth_date"
                    android:inputType="none" />

                <TextView
                    style="@style/BattleLabel"
                    android:id="@+id/textUsername"
                    android:text="@string/username" />

                <EditText
                    android:id="@+id/textUserName"
                    style="@style/BattleInput"
                    android:autofillHints="username"
                    android:hint="@string/enter_username"
                    android:inputType="text" />

                <TextView
                    style="@style/BattleLabel"
                    android:id="@+id/textPassword"
                    android:text="@string/password_display" />

                <EditText
                    android:id="@+id/textPasswordDetails"
                    style="@style/BattleInput"
                    android:autofillHints="newPassword"
                    android:hint="@string/password"
                    android:inputType="textPassword" />

                <TextView
                    style="@style/BattleLabel"
                    android:text="@string/confirm_password_label" />

                <EditText
                    android:id="@+id/textConfirmPassword"
                    style="@style/BattleInput"
                    android:autofillHints="newPassword"
                    android:hint="@string/confirm_password"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/signUpbutton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/loginbutton"
                    android:text="@string/signupButton"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/textTermsPrivacyPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/terms_privacy_policy"
                    android:textColor="@color/black"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
