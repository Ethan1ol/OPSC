<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".SettingsActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/buttonBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:text="@string/btn_back"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableStartCompat="@android:drawable/ic_media_previous" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                style="@style/BattleLabel"
                android:text="@string/settings_language" />

            <Spinner
                android:id="@+id/spinnerLanguage"
                style="@style/BattleSpinner" />

            <TextView
                style="@style/BattleLabel"
                android:text="@string/settings_country" />

            <Spinner
                android:id="@+id/spinnerCountry"
                style="@style/BattleSpinner" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPush"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="16dp"
                android:checked="true"
                android:text="@string/settings_push"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                style="@style/BattleLabel"
                android:layout_marginTop="24dp"
                android:text="@string/settings_profile_section"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                style="@style/BattleLabel"
                android:text="@string/name" />

            <EditText
                android:id="@+id/inputName"
                style="@style/BattleInput"
                android:autofillHints="givenName"
                android:hint="@string/enter_name"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/BattleLabel"
                android:text="@string/surname" />

            <EditText
                android:id="@+id/inputSurname"
                style="@style/BattleInput"
                android:autofillHints="familyName"
                android:hint="@string/enter_surname"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/BattleLabel"
                android:text="@string/username" />

            <EditText
                android:id="@+id/inputUsername"
                style="@style/BattleInput"
                android:autofillHints="username"
                android:hint="@string/enter_username"
                android:inputType="text" />

            <TextView
                style="@style/BattleLabel"
                android:text="@string/hint_height" />

            <EditText
                android:id="@+id/inputHeight"
                style="@style/BattleInput"
                android:autofillHints="@null"
                android:hint="@string/hint_height"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/BattleLabel"
                android:text="@string/hint_weight" />

            <EditText
                android:id="@+id/inputWeight"
                style="@style/BattleInput"
                android:autofillHints="@null"
                android:hint="@string/hint_weight"
                android:inputType="numberDecimal" />

            <Button
                android:id="@+id/buttonSave"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/loginbutton"
                android:text="@string/btn_save"
                android:textColor="@color/white" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
