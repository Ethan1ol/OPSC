<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Type scale (Poppins) ===== -->
    <style name="TextAppearance.Battle.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="lineHeight">36sp</item>
        <item name="android:fontFamily">@font/poppins_family_semibold</item>
        <item name="fontFamily">@font/poppins_family_semibold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Battle.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">28sp</item>
        <item name="android:fontFamily">@font/poppins_family_medium</item>
        <item name="fontFamily">@font/poppins_family_medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Battle.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:fontFamily">@font/poppins_family_regular</item>
        <item name="fontFamily">@font/poppins_family_regular</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Battle.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:fontFamily">@font/poppins_family_regular</item>
        <item name="fontFamily">@font/poppins_family_regular</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Battle.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:fontFamily">@font/poppins_family_medium</item>
        <item name="fontFamily">@font/poppins_family_medium</item>
    </style>

    <!-- ===== Shapes ===== -->
    <style name="ShapeAppearance.Battle.Control" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_control</item>
    </style>

    <style name="ShapeAppearance.Battle.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="ShapeAppearance.Battle.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sheet</item>
    </style>

    <style name="ShapeAppearance.Battle.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ===== Buttons (48dp tall, 12dp corners) ===== -->
    <style name="Widget.Battle.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:textAppearance">@style/TextAppearance.Battle.Label</item>
    </style>

    <!-- Secondary = tonal: filled with the soft orange container colour (clearer than a thin outline) -->
    <style name="Widget.Battle.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:textAppearance">@style/TextAppearance.Battle.Label</item>
    </style>

    <style name="Widget.Battle.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:textAppearance">@style/TextAppearance.Battle.Label</item>
    </style>

    <!-- ===== Text input with inline error text ===== -->
    <style name="Widget.Battle.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_control</item>
        <item name="errorEnabled">true</item>
        <item name="android:layout_marginTop">@dimen/space_sm</item>
    </style>

    <!-- Dropdown (exposed menu) version of the text input, used for country -->
    <style name="Widget.Battle.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_control</item>
        <item name="android:layout_marginTop">@dimen/space_sm</item>
    </style>

    <!-- ===== Cards (16dp corners, subtle elevation) ===== -->
    <style name="Widget.Battle.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="contentPadding">@dimen/space_md</item>
    </style>
</resources>
