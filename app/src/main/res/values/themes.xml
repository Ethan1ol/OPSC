<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Light theme only: the screens use fixed orange/white artwork with black text. -->
    <style name="Theme.OPSC" parent="Theme.MaterialComponents.Light.NoActionBar" />

    <!-- Shared widget styles so every screen looks the same. -->
    <style name="BattleLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="BattleInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/border</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/grey</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="BattleSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/border</item>
    </style>
</resources>
