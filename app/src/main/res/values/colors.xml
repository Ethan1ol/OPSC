<?xml version="1.0" encoding="utf-8"?>
<!--
  Battle Fitness colour tokens, LIGHT mode. values-night/colors.xml redefines the same
  names for dark mode. Screens never use hex values; they use theme attributes
  (?attr/colorPrimary etc.). Contrast is checked by DesignContrastTest.
-->
<resources>
    <!-- Brand: the logo orange. Decorative use or with dark text only (2.4:1 against white). -->
    <color name="bf_brand">#FF891B</color>
    <!-- Text colour to use on the brand orange (7.0:1), same in light and dark mode -->
    <color name="bf_on_brand">#331700</color>

    <!-- Primary: deeper orange, 5.7:1 with white text -->
    <color name="md_primary">#A94A00</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#FFDCC2</color>
    <color name="md_on_primary_container">#331700</color>

    <!-- Secondary: warm brown neutral -->
    <color name="md_secondary">#6B5748</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#F5E4D6</color>
    <color name="md_on_secondary_container">#2A1A0E</color>

    <!-- Surfaces: warm neutral background, white cards -->
    <color name="md_background">#FFF8F4</color>
    <color name="md_on_background">#231A12</color>
    <color name="md_surface">#FFFBF8</color>
    <color name="md_on_surface">#231A12</color>
    <color name="md_surface_variant">#F5E4D6</color>
    <color name="md_on_surface_variant">#54463B</color>
    <color name="md_surface_container_lowest">#FFFFFF</color>
    <color name="md_surface_container_low">#FFF1E8</color>
    <color name="md_surface_container">#FBEBDF</color>
    <color name="md_surface_container_high">#F5E4D6</color>
    <color name="md_outline">#85766B</color>
    <color name="md_outline_variant">#D8C3B4</color>

    <!-- Feedback: error (red) and success (green) -->
    <color name="md_error">#BA1A1A</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#FFDAD6</color>
    <color name="md_on_error_container">#410002</color>
    <color name="bf_success">#1B6E36</color>
    <color name="bf_on_success">#FFFFFF</color>
    <color name="bf_success_container">#BDF2C9</color>
    <color name="bf_on_success_container">#00210C</color>
</resources>
