rules_version = '2';

// Battle Fitness - Cloud Firestore security rules.
// Data model these rules assume (the app code in Pieces 2-8 must follow it):
//   users/{uid}                          profile, settings, fcmToken
//   users/{uid}/workouts/{workoutId}     synced workouts (private to the owner)
//   users/{uid}/notifications/{id}       in-app notifications for that user
//   clubs/{clubId}                       ownerId, name, description, inviteCode, memberIds[], status ('open' | 'active')
//   clubs/{clubId}/fixtures/{fixtureId}  player1Id, player2Id, refereeId, round, status, scores, proofUrl
//   clubs/{clubId}/standings/{uid}       points, played, won, drawn, lost

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function clubData(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data;
    }

    function isClubMember(clubId) {
      return signedIn() && request.auth.uid in clubData(clubId).memberIds;
    }

    function isClubOwner(clubId) {
      return signedIn() && request.auth.uid == clubData(clubId).ownerId;
    }

    // ---------- users ----------
    match /users/{uid} {
      // Any signed-in user may read profiles (needed for leaderboards and friend lists).
      allow read: if signedIn();
      // Only the owner may create, change or delete their own profile.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['email', 'username']);
      allow update, delete: if isOwner(uid);

      // Workouts are private to their owner.
      match /workouts/{workoutId} {
        allow read, write: if isOwner(uid);
      }

      // Pictures (avatar, banner) stored as small blobs: any signed-in user may view, only the owner may change.
      match /media/{mediaId} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }

      // Notifications: the owner reads/clears them. With no Cloud Function on the
      // free plan, other signed-in users may create one addressed to this user,
      // but only if they put their own uid in fromUid.
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid;
      }
    }

    // ---------- clubs ----------
    match /clubs/{clubId} {
      // Signed-in users can read clubs (needed to look a club up by invite code).
      allow read: if signedIn();

      // Creator must list themselves as owner and first member.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.status == 'open';

      // The owner can edit or delete the club. Anyone else may only JOIN, and only while the
      // league has not started (status 'open') and the club has room (max 12 members):
      // the only change allowed is adding their own uid to memberIds.
      allow update: if isClubOwner(clubId)
        || (signedIn()
            && resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds.size() <= 12
            && request.auth.uid in request.resource.data.memberIds);
      allow delete: if isClubOwner(clubId);

      // ---------- fixtures ----------
      match /fixtures/{fixtureId} {
        allow read: if isClubMember(clubId);
        // The club owner generates and removes fixtures.
        allow create, delete: if isClubOwner(clubId);
        // The owner can edit anything. The assigned referee may only record the
        // result (scores, winner, status, proof link), nothing else.
        allow update: if isClubOwner(clubId)
          || (isClubMember(clubId)
              && request.auth.uid == resource.data.refereeId
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['player1Score', 'player2Score', 'winnerId', 'status', 'proofUrl', 'verifiedAt']));
      }

      // The referee's proof photo for a fixture (a small blob). Members can view it; only that
      // fixture's referee (who must be a member) can save it.
      match /fixtures/{fixtureId}/proof/{proofId} {
        allow read: if isClubMember(clubId);
        allow write: if isClubMember(clubId)
          && request.auth.uid == get(/databases/$(database)/documents/clubs/$(clubId)/fixtures/$(fixtureId)).data.refereeId;
      }

      // ---------- standings ----------
      match /standings/{memberId} {
        allow read: if isClubMember(clubId);
        // Standings change when a referee verifies a result, so members who
        // are in the club may write them; the owner always may.
        allow write: if isClubOwner(clubId) || isClubMember(clubId);
      }
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
